    <!-- Help Screen -->
    <string name="help_center_title">Trung tâm hỗ trợ</string>
    <string name="faq_title">Câu hỏi thường gặp</string>
    <string name="faq_subtitle">Tìm câu trả lời cho vấn đề của bạn bên dưới</string>
    <string name="help_more_title">Vẫn cần hỗ trợ?</string>
    <string name="help_more_msg">Liên hệ với đội ngũ hỗ trợ của chúng tôi qua email tại https://chesko-25.vercel.app để được giúp đỡ thêm.</string>

    <string name="faq_q1">Cách thêm danh sách phát?</string>
    <string name="faq_a1">Bạn có thể thêm danh sách phát bằng cách nhấn nút \'Thêm\' ở màn hình đăng nhập, sau đó nhập URL M3U hợp lệ hoặc chọn tập tin từ bộ nhớ thiết bị.</string>
    <string name="faq_q2">Tại sao kênh không phát được?</string>
    <string name="faq_a2">Đảm bảo kết nối internet ổn định. Một số kênh có thể yêu cầu VPN hoặc bị giới hạn khu vực. Nếu sự cố vẫn tiếp diễn, hãy liên hệ với nhà cung cấp danh sách phát của bạn.</string>
    <string name="faq_q3">Cách xem lịch phát sóng (EPG)?</string>
    <string name="faq_a3">Mở Menu Drawer (biểu tượng ba gạch góc trên bên trái) rồi chọn \'Lịch phát sóng\'. EPG sẽ tự động được tải xuống nếu nguồn danh sách phát có cung cấp.</string>
    <string name="faq_q4">Cách thêm vào Yêu thích?</string>
    <string name="faq_a4">Khi đang phát video, nhấn biểu tượng \'Sao\' trong trình điều khiển. Hoặc bạn có thể nhấn giữ vào mục kênh trong danh sách chính.</string>
    <string name="faq_q5">Ứng dụng cảm thấy chậm, phải làm gì?</string>
    <string name="faq_a5">Bạn có thể thử xóa bộ nhớ đệm trong Cài đặt Android, hoặc giảm số lượng danh sách phát đang hoạt động nếu quá nhiều.</string>

